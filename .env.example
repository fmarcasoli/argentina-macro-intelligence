# ─────────────────────────────────────────────────────────────────────────────
# ARGENTINA MACRO INTELLIGENCE — variables de entorno
# Copiar a .env.local para desarrollo. Nunca commitear valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# Conexión PostgreSQL.
# Local (npm run db:start):
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/ami
# Supabase (producción / Vercel): usar el "Transaction pooler" (puerto 6543)
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Tamaño máximo del pool de conexiones (opcional).
# DATABASE_POOL_MAX=5

# Secreto que protege /api/sync. Vercel Cron lo envía como "Authorization: Bearer <CRON_SECRET>".
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Supabase (para la futura autenticación de usuarios; no se usan en Fase 1).
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
