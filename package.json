{
  "name": "argentina-macro-intelligence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:start": "tsx scripts/db-local.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "catalog:seed": "tsx scripts/catalog-seed.ts",
    "catalog:discover": "tsx scripts/catalog-discover.ts",
    "sync": "tsx scripts/sync.ts",
    "sync:full": "tsx scripts/sync.ts --full",
    "setup": "npm run db:migrate && npm run catalog:seed && npm run sync:full",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "LIVE_API_TESTS=1 vitest run tests/live",
    "catalog:classify": "tsx scripts/catalog-classify.ts",
    "econ:setup": "python3 -m venv .venv-econ && .venv-econ/bin/pip install -r scripts/econ/requirements.txt",
    "econ:tables": ".venv-econ/bin/python -I scripts/econ/export_tables.py",
    "econ:fixtures": ".venv-econ/bin/python -I scripts/econ/fetch_fixture.py",
    "econ:reference": ".venv-econ/bin/python -I scripts/econ/reference.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "html-to-image": "^1.11.13",
    "lucide-react": "^1.66.0",
    "next": "16.4.4",
    "postgres": "^4.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tw-animate-css": "^1.4.0",
    "write-excel-file": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^18.0.9",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^9",
    "eslint-config-next": "16.4.4",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  }
}
